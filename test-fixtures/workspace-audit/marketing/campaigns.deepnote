project:
  id: 11111111-1111-4111-8111-111111111111
  name: Marketing campaigns
  integrations:
    - id: aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa
      name: Warehouse
      type: snowflake
    - id: bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb
      name: Legacy Redshift
      type: redshift
  notebooks:
    - id: 1111aaaa2222bbbb3333cccc4444dddd
      name: Campaign performance
      blocks:
        - blockGroup: aaaa1111bbbb2222cccc3333dddd4444
          id: aaaa1111bbbb2222cccc3333dddd4441
          type: sql
          sortingKey: a0
          metadata:
            sql_integration_id: aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa
            deepnote_variable_name: campaigns
          content: |-
            SELECT c.id, c.spend, c.clicks
            FROM campaigns c
            WHERE c.ended_at IS NULL
              AND c.owner_email = 'jane.doe@acme-corp.io'
        - blockGroup: aaaa1111bbbb2222cccc3333dddd4445
          id: aaaa1111bbbb2222cccc3333dddd4442
          type: code
          sortingKey: a1
          metadata: {}
          content: |-
            import requests

            requests.post(
                "https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX",
                json={"text": f"{len(campaigns)} campaigns"},
            )
            campaigns.to_parquet("s3://marketing-exports/campaigns.parquet")
        - blockGroup: aaaa1111bbbb2222cccc3333dddd4446
          id: aaaa1111bbbb2222cccc3333dddd4443
          type: code
          sortingKey: a2
          metadata: {}
          content: |-
            SEGMENT_KEY = "9f8e7d6c5b4a39281706"
            requests.post("https://api.segment.io/v1/track", json={"key": SEGMENT_KEY})
version: '1'
