      name: Quarterly board pack
      blocks:
        - blockGroup: ffff1111222233334444555566660001
          id: ffff1111222233334444555566660001
          type: sql
          sortingKey: a0
          metadata:
            sql_integration_id: dddddddd-1111-4111-8111-dddddddddddd
            deepnote_variable_name: revenue
          content: |-
            SELECT sum(o.amount_gross) AS revenue
            FROM orders o
            JOIN users u ON o.email = u.email
        - blockGroup: ffff1111222233334444555566660002
          id: ffff1111222233334444555566660002
