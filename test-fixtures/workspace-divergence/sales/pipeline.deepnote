          type: sql
          sortingKey: a0
          metadata:
            sql_integration_id: dddddddd-1111-4111-8111-dddddddddddd
            deepnote_variable_name: revenue
          content: |-
            SELECT sum(o.amount) AS revenue
            FROM orders o
            JOIN users u ON o.user_id = u.id
            WHERE o.is_test = FALSE
