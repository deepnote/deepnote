metadata:
  createdAt: '2024-02-01T08:00:00.000Z'
  modifiedAt: '2026-09-20T09:00:00.000Z'
environment:
  python:
    version: '3.11'
  packages:
    pandas: 2.0.1
    numpy: 1.26.0
project:
  id: 11111111-aaaa-4aaa-8aaa-111111111111
  name: Revenue core
  integrations:
    - id: dddddddd-1111-4111-8111-dddddddddddd
      name: Warehouse
      type: snowflake
  notebooks:
    - id: aaaa1111bbbb2222cccc3333dddd4444
      name: Monthly revenue
      blocks:
        - blockGroup: aaaa1111bbbb2222cccc3333dddd0001
          id: aaaa1111bbbb2222cccc3333dddd0001
          type: sql
          sortingKey: a0
          metadata:
            sql_integration_id: dddddddd-1111-4111-8111-dddddddddddd
            deepnote_variable_name: revenue
          content: |-
            SELECT date_trunc('month', o.created_at) AS month,
                   sum(o.amount) AS revenue
            FROM orders o
            JOIN users u ON o.user_id = u.id
            WHERE o.is_test = false
            GROUP BY 1
        - blockGroup: aaaa1111bbbb2222cccc3333dddd0002
          id: aaaa1111bbbb2222cccc3333dddd0002
          type: sql
          sortingKey: a1
          metadata:
            sql_integration_id: dddddddd-1111-4111-8111-dddddddddddd
            deepnote_variable_name: signups
          content: |-
            SELECT count(*) AS signups FROM users WHERE is_test = false
version: '1'
