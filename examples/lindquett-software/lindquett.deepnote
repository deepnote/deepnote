      metadata:
        deepnote_variable_name: fail_on_alert
        deepnote_input_label: Fail the run when alerting
        deepnote_variable_value: false
        deepnote_variable_default_value: false
    - id: 9b579d892a7760bdc80b11dc64a53a8d
      blockGroup: 5cfceffd3fff226e06e9f3ce67b54456
      sortingKey: a004
      type: notebook-function
      content: ''
      metadata:
        function_notebook_id: 5f0c1d2e-7a41-4c8e-9b6a-0d1e2f3a4b01
        function_notebook_inputs: {}
