    - id: db4984bddc36f5390773383186f2b3a6
      blockGroup: b407fa4abac76a65aac65e43908ccc39
      sortingKey: a005
      type: notebook-function
      content: ''
      metadata:
        function_notebook_id: 5f0c1d2e-7a41-4c8e-9b6a-0d1e2f3a4b02
