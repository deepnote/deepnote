    - id: 2de3f9221ffd4dd4fee6edc0245be1e5
      blockGroup: 9117d7040fad52f944cf828ff5087ac3
      sortingKey: a002
      type: input-slider
      content: ''
      metadata:
        deepnote_variable_name: nrr_drop_points
        deepnote_input_label: Alert when NRR drops by more than (points)
        deepnote_variable_value: '5'
        deepnote_slider_min_value: 1
        deepnote_slider_max_value: 20
        deepnote_slider_step: 1
        deepnote_variable_default_value: '5'
    - id: be7fb571f1a761721030b5b19c99f8d6
      blockGroup: 4ed9ff5675dd425eb9b5345adc483b90
      sortingKey: a003
      type: input-checkbox
