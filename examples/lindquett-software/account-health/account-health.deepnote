        - id: 19f0ca00a44d316d6170c0f68a6e2ff2
          blockGroup: a5cb7048f794e8ae442b7a6b8a24a3ff
          sortingKey: "000006"
          type: code
          content: >-
            import pandas as pd


            # A 0-100 churn-risk score per paying account, with the reasons behind it. Revenue and retention

            # come from the governed modules, so a score never disagrees with the revenue review.

            def score_accounts(month):
                arr = lambda m: mrr[mrr["month"] == m].set_index("account_id")["mrr"] * 12
                now = arr(month)
                change_3m = (now / arr(month - pd.DateOffset(months=3)).reindex(now.index) - 1).fillna(0)
                change_12m = (now / arr(month - pd.DateOffset(months=12)).reindex(now.index) - 1).fillna(0)
                quarter = f"{month.year}-Q{month.quarter}"
                book = accounts.set_index("account_id").loc[now.index]
                peer_grr = {
                    (r, s): retention(mrr, quarter, r, s)["grr"]
                    for r, s in book[["region", "segment"]].drop_duplicates().itertuples(index=False)
                }
                rows = []
                for account_id, a in book.iterrows():
                    grr = peer_grr[(a["region"], a["segment"])]
                    signals = [
                        (35 * min(max(-change_3m[account_id], 0) / 0.3, 1), f"ARR {change_3m[account_id]:+.0%} in 3 months"),
                        (25 * min(max(-change_12m[account_id], 0) / 0.4, 1), f"ARR {change_12m[account_id]:+.0%} in 12 months"),
                        (25 * min(max(0.95 - grr, 0) / 0.15, 1), f"{a['region']} {a['segment']} peers keep {grr:.0%} of revenue"),
                        (15 if a["price_plan"] == "2026 price list" and a["segment"] != "Enterprise" else 0,
                         "Moved to the 2026 price list"),
                    ]
                    rows.append({
                        "account_id": account_id, "account": a["account"], "region": a["region"], "segment": a["segment"],
                        "industry": a["industry"], "price_plan": a["price_plan"], "arr": round(float(now[account_id]), 0),
                        "change_3m": round(float(change_3m[account_id]), 3), "change_12m": round(float(change_12m[account_id]), 3),
                        "peer_grr": round(float(grr), 3),
                        "score": round(sum(points for points, _ in signals)),
                        "drivers": [reason for points, reason in sorted(signals, reverse=True) if points >= 5],
                    })
                return pd.DataFrame(rows)

            as_of = mrr["month"].max()

            scores = score_accounts(as_of)

            last_month = score_accounts(as_of - pd.DateOffset(months=1)).set_index("account_id")["score"]

            scores["previous_score"] = scores["account_id"].map(last_month).fillna(0).astype(int)

            in_scope = scores if region == "All" else scores[scores["region"] == region]

            at_risk = in_scope[in_scope["score"] >= int(risk_threshold)]

            newly_at_risk = at_risk[at_risk["previous_score"] < int(risk_threshold)].sort_values("arr", ascending=False)

            at_risk.sort_values(["score", "arr"], ascending=False).head(10)
          metadata: {}
        - id: f226f2d9ecf9079014dfba12d8bf4c3e
          blockGroup: 7111656095056215db4a30f7b91613aa
          sortingKey: "000007"
          type: code
          content: >-
            import json

            import os

            import urllib.request


            # Post the accounts that crossed the threshold since last month, each linking to its page in the app.

            app_url = os.environ.get("ACCOUNT_HEALTH_URL", "").rstrip("/")

            message = None

            if not newly_at_risk.empty:
                lines = [f"*{len(newly_at_risk)} accounts crossed churn-risk score {risk_threshold}* (as of {as_of:%B %Y})"]
                for a in newly_at_risk.head(8).itertuples():
                    name = f"<{app_url}/?account={a.account_id}|{a.account}>" if app_url else a.account
                    lines.append(f"• {name}, {a.region} {a.segment}, ${a.arr / 1e3:,.0f}K ARR: score {a.score} ({a.drivers[0]})")
                if app_url:
                    lines.append(f"<{app_url}/?region={region}|Open account health>")
                message = "\n".join(lines)

            if message and notify:
                webhook = os.environ.get("SLACK_WEBHOOK_URL")
                if webhook:
                    request = urllib.request.Request(
                        webhook, data=json.dumps({"text": message}).encode(), headers={"Content-Type": "application/json"}
                    )
                    urllib.request.urlopen(request, timeout=10)
                    print("Sent to Slack:")
                else:
                    print("SLACK_WEBHOOK_URL is not set, so this message was not sent:")
                print(message)
            elif not message:
                print(f"No account crossed score {risk_threshold} since last month.")
          metadata: {}
        - id: 0d2b965864b6c1dbdf967bc2f6d91b3e
          blockGroup: d529337a96aa5a95b7a7a784a48ad6b4
          sortingKey: "000008"
          type: code
          content: >-
            from IPython.display import display


            display({"application/json": {
                "as_of": f"{as_of:%Y-%m}",
                "region": region,
                "threshold": int(risk_threshold),
                "summary": {
                    "accounts": len(in_scope),
                    "at_risk": len(at_risk),
                    "at_risk_arr": round(float(at_risk["arr"].sum()), 0),
                    "newly_at_risk": len(newly_at_risk),
                },
                "accounts": in_scope.sort_values(["score", "arr"], ascending=False).head(250).to_dict("records"),
                "newly_at_risk": newly_at_risk["account_id"].tolist(),
                "message": message,
            }}, raw=True)
          metadata: {}
