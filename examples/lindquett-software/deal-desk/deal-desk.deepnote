          sortingKey: "000000"
          type: markdown
          content: >-
            # Renewal quote


            One set of pricing rules for two callers: the deal desk app, where account managers pick an

            account and a term, and the CRM, which calls this notebook through the runs API. Both pass

            `account_id` and `term_years` and read the `application/json` output.
          metadata: {}
        - id: f6613aed521434bbdfd606ff02941563
          blockGroup: 280273cf80b587cd4106f057f00299fc
          sortingKey: "000001"
          type: input-text
          content: ""
          metadata:
            deepnote_variable_name: account_id
            deepnote_input_label: Account ID
            deepnote_variable_value: ACC-1003
            deepnote_variable_default_value: ACC-1003
        - id: b16b299d3c24bf601944d40b8ed0fd06
          blockGroup: 897129a66edf4b7946513fc20f99d3f7
          sortingKey: "000002"
          type: input-select
          content: ""
          metadata:
            deepnote_variable_name: term_years
            deepnote_input_label: Term (years)
            deepnote_variable_value: "1"
            deepnote_variable_default_value: "1"
            deepnote_variable_options:
              - "1"
              - "2"
              - "3"
            deepnote_variable_custom_options:
              - "1"
              - "2"
              - "3"
            deepnote_variable_selected_variable: ""
            deepnote_variable_select_type: from-options
            deepnote_allow_multiple_values: false
        - id: d80357e667b82ec66762783850c4e82f
          blockGroup: 49cd6da07c313d2e23935898c00a60d4
