    - id: ecae256568964ba44f5009a8cf7f7d4e
      blockGroup: 0c1ac8e49353c10c4e5eaf874e8c4315
      sortingKey: a018
      type: input-textarea
      content: ''
      metadata:
        deepnote_variable_name: question
