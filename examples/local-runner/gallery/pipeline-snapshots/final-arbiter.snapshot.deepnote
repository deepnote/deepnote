          executionStartedAt: 2026-07-29T11:01:06.513Z
          type: code
          content: |-
            import json

            decision_context = json.loads(decision_context_json)
            portfolio = decision_context["portfolio"]
            regions = portfolio["regions"]
            totals = portfolio["totals"]
            proposed_decision = portfolio["proposedDecision"]
            provider_reviews = decision_context["providerReviews"]

            print(
                f"Arbitrating {len(provider_reviews)} independent reviews for "
                f"{len(regions)} validated regions; forecast "
                f"${totals['forecastK']:,.0f}k vs target ${totals['targetK']:,.0f}k."
            )
          metadata:
