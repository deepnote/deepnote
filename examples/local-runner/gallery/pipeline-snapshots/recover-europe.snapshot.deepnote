        - id: af2a2bdc864b490295ade23006545823
          blockGroup: 73c8830876614947b3d2fea6bd6a6d84
          sortingKey: x
          contentHash: sha256:030ee1f2beff3752108e727cbd208db2e7dc84dd8b5ac3e35cd2ad9bac2977f5
          executionCount: 5
          executionFinishedAt: 2026-07-29T11:00:11.575Z
          executionStartedAt: 2026-07-29T11:00:11.573Z
          type: code
          content: >-
            import json


            CATALOG = {
                "North America": {"monthly_k": 440, "growth_pct": 2.0, "missing_months": 0},
                "Europe": {"monthly_k": 325, "growth_pct": 2.8, "missing_months": 1},
                "Asia Pacific": {"monthly_k": 255, "growth_pct": 4.2, "missing_months": 0},
            }


            if region not in CATALOG:
                raise ValueError(f"Unknown region: {region}")

            months = int(trailing_months)

            source = CATALOG[region]

            missing_months = 0 if backfill_missing else source["missing_months"]

            observed_months = months - min(months, missing_months)

            growth = source["growth_pct"] / 100

            revenue_k = round(
                sum(source["monthly_k"] * (1 + growth) ** index for index in range(observed_months)),
                1,
            )

            forecast_k = round(
                sum(
                    source["monthly_k"] * (1 + growth) ** (months + index)
                    for index in range(months)
                ),
                1,
            )

            target_k = round(float(monthly_target_k) * months, 1)


            result = {
                "region": region,
                "revenueK": revenue_k,
                "forecastK": forecast_k,
                "targetK": target_k,
                "growthPct": source["growth_pct"],
                "qualityScore": round(observed_months / months, 3),
                "backfilled": bool(backfill_missing),
                "onTrack": forecast_k >= target_k,
            }

            print(json.dumps(result, separators=(",", ":")))
          metadata:
            execution_start: 1785322811573
            execution_millis: 2
            execution_context_id: ff17154e-9926-47ad-b5a9-f5c8397c86ce
            source_block_id: f41cce1779674acab92055ec46e35af5
          outputs: [{"name":"stdout","text":"{\"region\":\"Europe\",\"revenueK\":2091.7,\"forecastK\":2468.6,\"targetK\":2040.0,\"growthPct\":2.8,\"qualityScore\":1.0,\"backfilled\":true,\"onTrack\":true}\n","output_type":"stream"}]
