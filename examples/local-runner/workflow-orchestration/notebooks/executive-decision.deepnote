metadata:
  createdAt: '2026-07-27T00:00:00.000Z'
project:
  id: workflow-executive-decision
  name: Workflow demo - executive decision
  notebooks:
    - id: workflow-executive-decision-notebook
      name: Executive decision
      blocks:
        - blockGroup: input-portfolio-group
          id: input-portfolio
          sortingKey: a0
          type: input-textarea
          content: ''
          metadata:
            deepnote_variable_name: portfolio_json
            deepnote_input_label: Validated regional portfolio
            deepnote_variable_value: '{}'
            deepnote_variable_default_value: ''
        - blockGroup: prepare-agent-group
          id: prepare-agent-context
          sortingKey: b0
          type: code
          content: |-
            import json

            portfolio = json.loads(portfolio_json)
            regions = portfolio["regions"]
            totals = portfolio["totals"]
            proposed_decision = portfolio["proposedDecision"]

            print(
                f"Validated {len(regions)} regions; "
                f"forecast ${totals['forecastK']:,.0f}k vs target ${totals['targetK']:,.0f}k; "
                f"proposed decision: {proposed_decision}"
            )
          metadata: {}
        - blockGroup: agent-group
          id: executive-agent
          sortingKey: c0
          type: agent
          content: |-
            Prepare the final decision memo for the sales leader using only the
            validated `regions`, `totals`, and `proposed_decision` variables already
            prepared by the notebook.

            Add one markdown block with:
            - a one-sentence decision;
            - three bullets citing the most decision-relevant regional numbers;
            - one concrete next action.

            Do not reload data or invent numbers. Keep the memo below 140 words.
          metadata:
            deepnote_agent_model: auto
version: 1.0.0
