{
  "name": "@deepnote/runtime-core",
  "version": "0.6.0",
  "description": "Core runtime for executing Deepnote projects",
  "keywords": [
    "deepnote",
    "runtime",
    "notebook"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deepnote/deepnote.git",
    "directory": "packages/runtime-core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.76",
    "@ai-sdk/mcp": "^2.0.71",
    "@ai-sdk/openai": "^4.0.89",
    "@ai-sdk/openai-compatible": "^3.0.66",
    "@deepnote/blocks": "workspace:*",
    "@jupyterlab/nbformat": "^4.6.3",
    "@jupyterlab/services": "^7.6.3",
    "@lumino/signaling": "^2.1.6",
    "ai": "^7.0.133",
    "tcp-port-used": "^1.0.3",
    "ws": "^8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/tcp-port-used": "^1.0.4",
    "@types/ws": "^8.18.1"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
